# ==============================================================================
# Cloud File Storage System - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to '.env':
#      Copy-Item .env.example .env
# 2. Update the dummy values below with your development settings.
# 3. NEVER commit your actual '.env' file or AWS credentials to version control.
# ==============================================================================

# Application Environment (options: development, testing, staging, production)
APP_ENV=development

# AWS S3 Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-private-cloud-storage-bucket-placeholder
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_PLACEHOLDER

# Metadata Database Configuration
# Local SQLite database path for development; can point to PostgreSQL connection string in production
DATABASE_PATH=data/cloud_storage.db

# Storage & Upload Policies
MAX_FILE_SIZE_MB=50
DEFAULT_STORAGE_QUOTA_MB=500
SHARE_LINK_MAX_EXPIRY_HOURS=168
